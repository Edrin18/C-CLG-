#include <iostream>
using namespace std;

int main() {
    int a = 10;
    int b = 3;

    cout << "Initial value of a: " << a << endl;

    a += b;
    cout << "After a += b : " << a << endl;

    a -= b;
    cout << "After a -= b : " << a << endl;

    a *= b;
    cout << "After a *= b : " << a << endl;

    a /= b;
    cout << "After a /= b : " << a << endl;

    a %= b;
    cout << "After a %= b : " << a << endl;

    return 0;
}
